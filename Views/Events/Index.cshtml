@using Gumani_Moila_ST10229429_CLDV7111w.Models
@using Gumani_Moila_ST10229429_CLDV7111w.Helpers
@model PaginatedList<Event>

@{
    ViewData["Title"] = "Index";
}

<div class="w-full flex justify-between items-center mb-20 px-4">

        <a href="javascript:history.back()"
           class="inline-flex items-center px-3 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300 transition-all shadow-sm">
            <i class="fa-solid fa-arrow-left mr-2"></i>
            <span>Back</span>
        </a>
    
    <a asp-action="Create" class="bg-blue-600 py-2 px-3 rounded text-white">Add event</a>
</div>

@* // search box *@
<form asp-action="Index" method="get" id="searchForm"
      class="max-w-3xl mx-auto flex flex-col gap-4 px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 mb-6">

    <!-- Text search -->
    <div class="flex items-center gap-2">
        <input type="text" value="@ViewData["CurrentSearch"]" id="searchInput" name="searchInput"
               placeholder="Search by id, event name, venue"
               class="flex-1 px-3 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-600 focus:border-transparent outline-none transition-all" />
    </div>

    <!-- Filters row -->
    <div class="flex flex-wrap items-center gap-4">
        <!-- Event type filter -->
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-filter text-gray-400"></i>
            <select id="eventTypeFilter" name="eventTypeFilter"
                    class="px-2 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-600 focus:border-transparent outline-none">
                <option value="">All Event Types</option>
                @foreach (var type in Enum.GetValues(typeof(Event.EventCategory)).Cast<Event.EventCategory>())
                {
                    <option value="@type" selected="@(ViewData["EventTypeFilter"]?.ToString() == type.ToString())">@type</option>
                }
            </select>
        </div>

        <!-- Availability filter -->
        <select id="availabilityFilter" name="availabilityFilter"
                class="px-2 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-600 focus:border-transparent outline-none">
            <option value="">All</option>
            <option value="Available" selected="@(ViewData["AvailabilityFilter"]?.ToString() == "Available")">Available</option>
            <option value="Unavailable" selected="@(ViewData["AvailabilityFilter"]?.ToString() == "Unavailable")">Unavailable</option>
        </select>

        <!-- Date range filter -->
        <div class="flex items-center gap-2">
            <label for="fromDate" class="text-sm text-gray-600">From</label>
            <input type="date" id="fromDate" name="fromDate"
                   value="@ViewData["FromDate"]"
                   class="px-2 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-600 focus:border-transparent outline-none" />

            <label for="toDate" class="text-sm text-gray-600">To</label>
            <input type="date" id="toDate" name="toDate"
                   value="@ViewData["ToDate"]"
                   class="px-2 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-600 focus:border-transparent outline-none" />
        </div>

        <!-- Sort order -->
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-sliders text-gray-400"></i>
            <select id="sortOrder" name="sortOrder"
                    class="px-2 py-2 rounded-lg border border-gray-300 bg-gray-100 focus:ring-2 focus:ring-blue-600 focus:border-transparent outline-none">
                <option value="Default" selected="@(ViewData["CurrentSort"]?.ToString() == "Default")">Default</option>
                <option value="Most Recent" selected="@(ViewData["CurrentSort"]?.ToString() == "Most Recent")">Most Recent</option>
                <option value="Oldest" selected="@(ViewData["CurrentSort"]?.ToString() == "Oldest")">Oldest</option>
            </select>
        </div>
    </div>
</form>
<div id="resultsContainer">

<div class="flex flex-wrap gap-6 p-12 justify-center items-center">
@foreach (var item in Model)
{
    <div class="max-w-md w-full px-2 py-1 rounded flex flex-row gap-3
        shadow-lg bg-white">
        <img class="w-[120px] h-[130px] object-cover rounded"
             src="@Html.DisplayFor(modelItem => item.Venue.VenueImageUrl)"
             alt="Event Image" />
        <div class=" flex-1">
            <div class="flex flex-row justify-between align-items-center">
                <a asp-action="Edit" class="text-blue-600 text-sm" asp-route-id="@item.EventId"><i class="fa-regular fa-pen-to-square"></i></a>
                @* <a asp-action="Details" asp-route-id="@item.UserId">Details</a> | *@
                <a asp-action="Delete" class="text-red-600 text-sm" asp-route-id="@item.EventId"><i class="fa-regular fa-trash-can"></i></a>
            </div>
            <div class="flex flex-row justify-between align-items-center">
                <div class="font-semibold text-sm">@Html.DisplayFor(modelItem => item.EventName)</div>
                @* // display only the date not time *@
                <p class="text-gray-500 text-xs font-medium"> @item.EventDate.ToString("dd-MM-yyyy")</p>
            </div>

            <p class=" text-sm capitalize"><i class="fa-solid fa-location-dot"></i>@Html.DisplayFor(modelItem => item.Venue.VenueName), @Html.DisplayFor(modelItem => item.Venue.VenueLocation)</p>
            @* // display only time  *@
            <p class="text-gray-700 text-sm">@item.EventDate.ToString("HH:mm")</p>
                <div class="flex flex-row justify-between align-items-center mb-2">
                    <p class="text-sm font-medium"> Event Type: @Html.DisplayFor(modelItem => item.EventType)</p>
                    @* // available badge *@
                    <div class="text-xs font-medium px-2 py-1 rounded-full @(item.IsAvailable ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                        @(item.IsAvailable ? "Available" : "Unavailable")
                    </div>

                </div>
            <div class=" flex items-center justify-between">
                <p><strong class="text-green-600 text-sm">@Html.DisplayFor(modelItem => item.Venue.VenueCapacity) </strong>-><strong class="text-red-700 text-sm"> @Html.DisplayFor(modelItem => item.RemainingSeats)</strong></p>
                    <a asp-controller="Bookings"
                       asp-action="Create"
                       asp-route-eventId="@item.EventId"
                       asp-route-venueId="@item.VenueId"
                       class="bg-black text-white px-3 py-1 rounded-sm text-xs text-center hover:bg-gray-800">
                        Book
                    </a>
            </div>
        </div>
    </div>
}
</div>
</div>

    
@* // pagination *@
@if (Model.TotalPages > 1)
{
    <div class="flex flex-row gap-3 items-center justify-center mt-6">
        @if (Model.HasPreviousPage)
        {
            <a class="px-3 py-1 rounded bg-gray-200 text-gray-700 hover:bg-gray-300 transition-all text-sm"
            href="@Url.Action("Index", new { pageNumber = Model.PageIndex - 1 })">Previous</a>
        }
        else
        {
            <span class="px-3 py-1 rounded bg-gray-100 text-gray-400 text-sm">Previous</span>
        }

        <p class="text-black px-3">Page @Model.PageIndex of @Model.TotalPages</p>

        @if (Model.HasNextPage)
        {
            <a class="px-3 py-1 rounded bg-gray-200 text-gray-700 hover:bg-gray-300 transition-all text-sm"
            href="@Url.Action("Index", new { pageNumber = Model.PageIndex + 1 })">Next</a>
        }
        else
        {
            <span class="px-3 py-1 rounded bg-gray-100 text-gray-400 text-sm">Next</span>
        }
    </div>

}


<script>
    const searchInput = document.getElementById("searchInput");
    const sortOrder = document.getElementById("sortOrder");
    const eventTypeFilter = document.getElementById("eventTypeFilter");
    const availabilityFilter = document.getElementById("availabilityFilter");
    const fromDate = document.getElementById("fromDate");
    const toDate = document.getElementById("toDate");

    // Build query string with all filters
    function buildQuery() {
        return `/Events/Index?searchInput=${encodeURIComponent(searchInput.value)}`
             + `&sortOrder=${encodeURIComponent(sortOrder.value)}`
             + `&eventTypeFilter=${encodeURIComponent(eventTypeFilter.value)}`
             + `&availabilityFilter=${encodeURIComponent(availabilityFilter.value)}`
             + `&fromDate=${encodeURIComponent(fromDate.value)}`
             + `&toDate=${encodeURIComponent(toDate.value)}`;
    }

    // Update results safely
    function updateResults() {
        fetch(buildQuery())
            .then(response => response.text())
            .then(html => {
                const parsed = new DOMParser().parseFromString(html, "text/html");
                const newResults = parsed.getElementById("resultsContainer");
                const currentResults = document.getElementById("resultsContainer");

                if (newResults && currentResults) {
                    currentResults.innerHTML = newResults.innerHTML;
                } else {
                    console.warn("resultsContainer not found in response");
                }
            })
            .catch(err => console.error("Update failed:", err));
    }

    // Auto-search after typing (debounced)
    let typingTimer;
    searchInput.addEventListener("input", function () {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(updateResults, 500);
    });

    // Refresh results when filters change
    [sortOrder, eventTypeFilter, availabilityFilter, fromDate, toDate].forEach(el => {
        el.addEventListener("change", updateResults);
    });
</script>